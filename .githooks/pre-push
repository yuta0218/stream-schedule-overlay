#!/usr/bin/env bash
# 送信する履歴の秘密情報と、mainへの直接pushを検査します。
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = refs/heads/main ]; then
    echo "mainには直接pushせず、作業ブランチを使ってください。" >&2
    exit 1
  fi
  if [ "$local_sha" = "$zero" ]; then continue; fi
  if [ "$remote_sha" = "$zero" ]; then
    python3 scripts/check-secrets.py --history "$local_sha"
  else
    python3 scripts/check-secrets.py --history "$remote_sha..$local_sha"
  fi
done
